{
  "name": "puddingharness-electron",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:dir": "electron-builder --dir",
    "build:dmg": "electron-builder --mac dmg --arm64",
    "verify:runtime": "node ../packages/puddingclaw-deploy-cli/scripts/verify-publish.mjs",
    "prebuild": "npm run verify:runtime",
    "prebuild:dir": "npm run verify:runtime",
    "prebuild:dmg": "npm run verify:runtime"
  },
  "build": {
    "appId": "com.puddingai.puddingharness",
    "productName": "PuddingHarness",
    "forceCodeSigning": true,
    "directories": {
      "output": "../dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/icon.png",
      "managers/**/*",
      "!node_modules/electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "pyproject.toml",
          "uv.lock",
          "app.py",
          "capabilities.py",
          "config.py",
          "provider_registry.py",
          "*.py",
          "api/**/*",
          "connectors/**/*",
          "evaluation/**/*",
          "graph/**/*",
          "harness/**/*",
          "llm/**/*",
          "mcp_clients/**/*",
          "memory/**/*",
          "projects/**/*",
          "prompts/**/*",
          "runtime_identity/**/*",
          "services/**/*",
          "sessions/**/*",
          "skills/**/*",
          "storage/**/*",
          "tools/**/*",
          "utils/**/*",
          "web_search/**/*",
          "workspace/**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.DS_Store"
        ]
      },
      {
        "from": "../README.md",
        "to": "README.md"
      },
      {
        "from": "../packages/puddingclaw-deploy-cli",
        "to": "cli",
        "filter": [
          "package.json",
          "worker.manifest.json",
          "src/**/*",
          "runtime-bundle/**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.DS_Store"
        ]
      }
    ],
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "signing/entitlements.mac.plist",
      "entitlementsInherit": "signing/entitlements.mac.inherit.plist",
      "signIgnore": [
        "/Contents/Resources/backend/",
        "/Contents/Resources/cli/",
        "/Contents/Resources/frontend/"
      ],
      "notarize": true
    },
    "asar": true,
    "asarUnpack": [
      "managers/**/*.js"
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0"
  }
}
