{
  "name": "@puddingai/puddingharness",
  "version": "0.1.20-rc.4",
  "private": true,
  "description": "CLI installer, runtime manager, and Agent Harness client for PuddingHarness",
  "license": "MIT",
  "type": "module",
  "bin": {
    "puddingharness": "src/cli.js"
  },
  "files": [
    "src",
    "runtime-bundle",
    "worker.manifest.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build:runtime": "node scripts/build-embedded-runtime.mjs",
    "test": "node --test test/*.test.js",
    "verify:publish": "node scripts/verify-publish.mjs",
    "prepublishOnly": "npm test && npm run verify:publish",
    "verify:candidate": "node scripts/verify-publish.mjs --candidate"
  }
}
