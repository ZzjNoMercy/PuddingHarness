{
  "schemaVersion": "1",
  "id": "puddingharness",
  "name": "Pudding Harness",
  "description": "通用 Agent Harness Worker",
  "kind": "agent-worker",
  "protocolVersion": "1",
  "transport": {
    "type": "cli",
    "command": "puddingharness",
    "input": "stdin-json",
    "output": "stdout-json"
  },
  "capabilities": ["agent.run", "agent.continue", "agent.respond", "agent.cancel", "hitl.permission"],
  "commands": {
    "probe": ["doctor", "--json"],
    "capabilities": ["agent", "capabilities", "--json"],
    "models": ["agent", "models", "list", "--json"],
    "run": ["agent", "run", "--input-json", "-", "--json"],
    "respond": ["agent", "respond", "<run_id>", "--input-json", "-", "--json"],
    "cancel": ["agent", "cancel", "<run_id>", "--json"]
  },
  "operations": {
    "run": true,
    "continue": true,
    "respond": true,
    "cancel": true
  },
  "interactionKinds": ["permission_request"],
  "progress": "jsonl"
}
